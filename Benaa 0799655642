<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bentech — Tech Enthusiast & Digital Creator</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            heading: ['Poppins', 'sans-serif'],
            body: ['Inter', 'sans-serif'],
          },
          colors: {
            ink: '#0a0e1a',
            panel: '#111827',
            neon: '#00e5ff',
            violet: '#8b5cf6',
          },
          animation: {
            'fade-up': 'fadeUp 0.8s ease-out forwards',
            'glow': 'glow 3s ease-in-out infinite',
          },
          keyframes: {
            fadeUp: {
              '0%': { opacity: '0', transform: 'translateY(24px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            },
            glow: {
              '0%, 100%': { boxShadow: '0 0 20px rgba(0,229,255,0.3)' },
              '50%': { boxShadow: '0 0 40px rgba(139,92,246,0.5)' },
            },
          },
        },
      },
    };
  </script>
  <style>
    html { scroll-behavior: smooth; }
    body { background: #0a0e1a; }
    .reveal { opacity: 0; transform: translateY(24px); transition: all 0.8s ease-out; }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .gradient-text {
      background: linear-gradient(90deg, #00e5ff 0%, #8b5cf6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .grid-bg {
      background-image:
        linear-gradient(rgba(0,229,255,0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,229,255,0.06) 1px, transparent 1px);
      background-size: 48px 48px;
    }
  </style>
</head>
<body class="font-body text-gray-200 antialiased">

  <!-- NAVBAR -->
  <nav class="fixed top-0 inset-x-0 z-50 backdrop-blur-md bg-ink/70 border-b border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="#home" class="font-heading font-bold text-xl tracking-tight">
        <span class="gradient-text">Ben</span><span class="text-white">tech</span>
      </a>
      <div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-300">
        <a href="#about" class="hover:text-neon transition">About</a>
        <a href="#skills" class="hover:text-neon transition">Skills</a>
        <a href="#projects" class="hover:text-neon transition">Projects</a>
        <a href="#contact" class="hover:text-neon transition">Contact</a>
        <a href="#contact" class="px-4 py-2 rounded-lg bg-neon/10 border border-neon/40 text-neon hover:bg-neon/20 transition">Hire Me</a>
      </div>
      <button id="menuBtn" class="md:hidden text-2xl"><i class="fa-solid fa-bars"></i></button>
    </div>
    <div id="mobileMenu" class="hidden md:hidden px-6 pb-4 space-y-3 text-sm">
      <a href="#about" class="block hover:text-neon">About</a>
      <a href="#skills" class="block hover:text-neon">Skills</a>
      <a href="#projects" class="block hover:text-neon">Projects</a>
      <a href="#contact" class="block hover:text-neon">Contact</a>
    </div>
  </nav>

  <!-- HERO -->
  <section id="home" class="relative min-h-screen flex items-center grid-bg overflow-hidden">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-neon/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-violet/20 rounded-full blur-3xl"></div>

    <div class="relative max-w-6xl mx-auto px-6 py-32 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="inline-block px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs tracking-widest text-neon mb-6">
          <i class="fa-solid fa-circle text-[6px] align-middle mr-2"></i>AVAILABLE FOR WORK
        </p>
        <h1 class="font-heading font-extrabold text-5xl md:text-6xl leading-tight">
          Building the future,<br />
          <span class="gradient-text">one line at a time.</span>
        </h1>
        <p class="mt-6 text-lg text-gray-400 max-w-lg">
          I'm <span class="text-white font-semibold">Bentech</span> — a tech enthusiast and digital creator turning bold ideas into clean, functional, and future-ready experiences.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#projects" class="px-6 py-3 rounded-xl bg-neon text-ink font-semibold hover:bg-cyan-300 transition animate-glow">
            <i class="fa-solid fa-rocket mr-2"></i>View My Work
          </a>
          <a href="#contact" class="px-6 py-3 rounded-xl border border-white/20 hover:border-neon hover:text-neon transition font-semibold">
            Get in Touch
          </a>
        </div>
      </div>

      <div class="relative flex justify-center">
        <div class="w-72 h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tr from-neon/30 to-violet/30 blur-2xl absolute"></div>
        <div class="relative w-64 h-64 md:w-72 md:h-72 rounded-3xl bg-panel border border-white/10 flex items-center justify-center overflow-hidden">
          <div class="absolute inset-0 grid-bg opacity-40"></div>
          <i class="fa-solid fa-user-astronaut text-7xl text-neon relative z-10"></i>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-24 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 reveal">
      <p class="text-neon text-sm tracking-widest font-semibold mb-2">01 — ABOUT ME</p>
      <h2 class="font-heading font-bold text-4xl mb-8">Who is <span class="gradient-text">Bentech</span>?</h2>
      <div class="grid md:grid-cols-3 gap-10">
        <div class="md:col-span-2 space-y-5 text-gray-400 leading-relaxed">
          <p>
            Bentech is the persona of a passionate builder who lives at the intersection of code, design, and curiosity. From the first time a line of HTML turned into something visible on a screen, technology became less of a tool and more of a language — a way to solve real problems and tell real stories.
          </p>
          <p>
            Today, Bentech focuses on crafting modern web experiences, exploring AI-powered workflows, and helping people turn rough ideas into polished digital products. Whether it's a sleek dashboard or a full brand identity, the goal is always the same: make tech feel effortless, human, and a little bit exciting.
          </p>
        </div>
        <div class="bg-panel border border-white/10 rounded-2xl p-6 space-y-4">
          <div class="flex justify-between text-sm"><span class="text-gray-500">Location</span><span>Remote / Global</span></div>
          <div class="flex justify-between text-sm"><span class="text-gray-500">Focus</span><span>Web • AI • Design</span></div>
          <div class="flex justify-between text-sm"><span class="text-gray-500">Status</span><span class="text-neon">Open to projects</span></div>
          <div class="flex justify-between text-sm"><span class="text-gray-500">Coffee</span><span>☕☕☕☕☕</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="py-24 border-t border-white/5 bg-panel/30">
    <div class="max-w-6xl mx-auto px-6 reveal">
      <p class="text-neon text-sm tracking-widest font-semibold mb-2">02 — SKILLS & SERVICES</p>
      <h2 class="font-heading font-bold text-4xl mb-12">What I <span class="gradient-text">do best</span></h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="group bg-panel border border-white/10 rounded-2xl p-6 hover:border-neon/60 hover:-translate-y-1 transition duration-300">
          <div class="w-12 h-12 rounded-xl bg-neon/10 text-neon flex items-center justify-center text-xl mb-4 group-hover:bg-neon/20 transition">
            <i class="fa-solid fa-code"></i>
          </div>
          <h3 class="font-heading font-semibold text-lg">Web Development</h3>
          <p class="text-sm text-gray-400 mt-2">Fast, responsive, and accessible sites built with modern HTML, CSS, JS, and frameworks.</p>
        </div>
        <!-- Card 2 -->
        <div class="group bg-panel border border-white/10 rounded-2xl p-6 hover:border-neon/60 hover:-translate-y-1 transition duration-300">
          <div class="w-12 h-12 rounded-xl bg-violet/10 text-violet flex items-center justify-center text-xl mb-4 group-hover:bg-violet/20 transition">
            <i class="fa-solid fa-brain"></i>
          </div>
          <h3 class="font-heading font-semibold text-lg">AI & Automation</h3>
          <p class="text-sm text-gray-400 mt-2">Integrating AI tools and automating workflows to save time and unlock new possibilities.</p>
        </div>
        <!-- Card 3 -->
        <div class="group bg-panel border border-white/10 rounded-2xl p-6 hover:border-neon/60 hover:-translate-y-1 transition duration-300">
          <div class="w-12 h-12 rounded-xl bg-neon/10 text-neon flex items-center justify-center text-xl mb-4 group-hover:bg-neon/20 transition">
            <i class="fa-solid fa-pen-ruler"></i>
          </div>
          <h3 class="font-heading font-semibold text-lg">UI/UX Design</h3>
          <p class="text-sm text-gray-400 mt-2">Clean interfaces and thoughtful user flows that feel intuitive from the first click.</p>
        </div>
        <!-- Card 4 -->
        <div class="group bg-panel border border-white/10 rounded-2xl p-6 hover:border-neon/60 hover:-translate-y-1 transition duration-300">
          <div class="w-12 h-12 rounded-xl bg-violet/10 text-violet flex items-center justify-center text-xl mb-4 group-hover:bg-violet/20 transition">
            <i class="fa-solid fa-puzzle-piece"></i>
          </div>
          <h3 class="font-heading font-semibold text-lg">Problem Solving</h3>
          <p class="text-sm text-gray-400 mt-2">Breaking down complex challenges into clear, actionable, and elegant solutions.</p>
        </div>
        <!-- Card 5 -->
        <div class="group bg-panel border border-white/10 rounded-2xl p-6 hover:border-neon/60 hover:-translate-y-1 transition duration-300">
          <div class="w-12 h-12 rounded-xl bg-neon/10 text-neon flex items-center justify-center text-xl mb-4 group-hover:bg-neon/20 transition">
            <i class="fa-solid fa-mobile-screen"></i>
          </div>
          <h3 class="font-heading font-semibold text-lg">Responsive Design</h3>
          <p class="text-sm text-gray-400 mt-2">Every layout looks sharp — from a 4K monitor to the phone in your pocket.</p>
        </div>
        <!-- Card 6 -->
        <div class="group bg-panel border border-white/10 rounded-2xl p-6 hover:border-neon/60 hover:-translate-y-1 transition duration-300">
          <div class="w-12 h-12 rounded-xl bg-violet/10 text-violet flex items-center justify-center text-xl mb-4 group-hover:bg-violet/20 transition">
            <i class="fa-solid fa-lightbulb"></i>
          </div>
          <h3 class="font-heading font-semibold text-lg">Creative Strategy</h3>
          <p class="text-sm text-gray-400 mt-2">Turning vague ideas into a clear direction with the right mix of tech and creativity.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="py-24 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 reveal">
      <p class="text-neon text-sm tracking-widest font-semibold mb-2">03 — FEATURED PROJECTS</p>
      <h2 class="font-heading font-bold text-4xl mb-12">Things I've <span class="gradient-text">built</span></h2>
      <div class="grid md:grid-cols-3 gap-6">
        <article class="bg-panel border border-white/10 rounded-2xl overflow-hidden hover:border-neon/60 hover:-translate-y-1 transition duration-300">
          <div class="h-40 bg-gradient-to-br from-neon/30 to-violet/30 flex items-center justify-center">
            <i class="fa-solid fa-house-signal text-5xl text-white/80"></i>
          </div>
          <div class="p-6">
            <h3 class="font-heading font-semibold text-lg">Project Alpha</h3>
            <p class="text-sm text-gray-400 mt-2">A smart home dashboard that unifies devices, automations, and energy insights in one clean UI.</p>
            <a href="#" class="inline-block mt-4 text-sm text-neon hover:underline">Case study →</a>
          </div>
        </article>
        <article class="bg-panel border border-white/10 rounded-2xl overflow-hidden hover:border-neon/60 hover:-translate-y-1 transition duration-300">
          <div class="h-40 bg-gradient-to-br from-violet/30 to-neon/30 flex items-center justify-center">
            <i class="fa-solid fa-robot text-5xl text-white/80"></i>
          </div>
          <div class="p-6">
            <h3 class="font-heading font-semibold text-lg">Project Nova</h3>
            <p class="text-sm text-gray-400 mt-2">An AI chat assistant that helps small teams automate research, drafting, and reporting tasks.</p>
            <a href="#" class="inline-block mt-4 text-sm text-neon hover:underline">Case study →</a>
          </div>
        </article>
        <article class="bg-panel border border-white/10 rounded-2xl overflow-hidden hover:border-neon/60 hover:-translate-y-1 transition duration-300">
          <div class="h-40 bg-gradient-to-br from-neon/20 to-violet/40 flex items-center justify-center">
            <i class="fa-solid fa-chart-line text-5xl text-white/80"></i>
          </div>
          <div class="p-6">
            <h3 class="font-heading font-semibold text-lg">Project Orbit</h3>
            <p class="text-sm text-gray-400 mt-2">A lightweight analytics web app with real-time charts and a focus on privacy-first data tracking.</p>
            <a href="#" class="inline-block mt-4 text-sm text-neon hover:underline">Case study →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-24 border-t border-white/5 bg-panel/30">
    <div class="max-w-6xl mx-auto px-6 reveal grid md:grid-cols-2 gap-12">
      <div>
        <p class="text-neon text-sm tracking-widest font-semibold mb-2">04 — CONTACT</p>
        <h2 class="font-heading font-bold text-4xl mb-6">Let's build <span class="gradient-text">something</span>.</h2>
        <p class="text-gray-400 max-w-md">
          Have an idea, a project, or just want to say hi? Drop me a message — I usually reply within 24 hours.
        </p>
        <div class="mt-8 space-y-3 text-sm">
          <p><i class="fa-solid fa-envelope text-neon mr-3"></i>hello@bentech.dev</p>
          <p><i class="fa-solid fa-location-dot text-neon mr-3"></i>Remote / Worldwide</p>
        </div>
        <div class="mt-8 flex gap-4 text-xl">
          <a href="#" class="w-11 h-11 rounded-xl bg-panel border border-white/10 flex items-center justify-center hover:text-neon hover:border-neon/60 transition"><i class="fa-brands fa-github"></i></a>
          <a href="#" class="w-11 h-11 rounded-xl bg-panel border border-white/10 flex items-center justify-center hover:text-neon hover:border-neon/60 transition"><i class="fa-brands fa-linkedin-in"></i></a>
          <a href="#" class="w-11 h-11 rounded-xl bg-panel border border-white/10 flex items-center justify-center hover:text-neon hover:border-neon/60 transition"><i class="fa-brands fa-x-twitter"></i></a>
          <a href="#" class="w-11 h-11 rounded-xl bg-panel border border-white/10 flex items-center justify-center hover:text-neon hover:border-neon/60 transition"><i class="fa-brands fa-dribbble"></i></a>
        </div>
      </div>

      <form id="contactForm" class="bg-panel border border-white/10 rounded-2xl p-6 space-y-4">
        <div>
          <label class="text-sm text-gray-400 mb-1 block">Name</label>
          <input type="text" required class="w-full bg-ink border border-white/10 rounded-lg px-4 py-3 text-sm focus:border-neon focus:outline-none transition" placeholder="Your name" />
        </div>
        <div>
          <label class="text-sm text-gray-400 mb-1 block">Email</label>
          <input type="email" required class="w-full bg-ink border border-white/10 rounded-lg px-4 py-3 text-sm focus:border-neon focus:outline-none transition" placeholder="you@example.com" />
        </div>
        <div>
          <label class="text-sm text-gray-400 mb-1 block">Message</label>
          <textarea rows="4" required class="w-full bg-ink border border-white/10 rounded-lg px-4 py-3 text-sm focus:border-neon focus:outline-none transition" placeholder="Tell me about your project..."></textarea>
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-neon text-ink font-semibold hover:bg-cyan-300 transition">
          <i class="fa-solid fa-paper-plane mr-2"></i>Send Message
        </button>
        <p id="formMsg" class="text-sm text-neon hidden">Thanks! Your message has been received. 🚀</p>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="py-8 border-t border-white/5 text-center text-sm text-gray-500">
    © <span id="year"></span> Bentech. Built with <i class="fa-solid fa-heart text-red-500"></i> and lots of coffee.
  </footer>

  <script>
    // Mobile menu
    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));

    // Scroll reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Form submit (demo)
    document.getElementById('contactForm').addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('formMsg').classList.remove('hidden');
      e.target.reset();
    });

    // Year
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
